{
  "name": "uvision-fast",
  "displayName": "uVision Fast (Keil µVision 5 IDE)",
  "description": "Fast Keil µVision 5 replica IDE & ARM Cortex-M3 / STM32F1 simulator/hardware debugger backed by uvcli",
  "version": "0.2.0",
  "publisher": "ruet-cse3108",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.mjs",
    "build:webview": "cd ../web && npx vite build --mode vscode",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "tsc --noEmit && node esbuild.mjs --production"
  },
  "contributes": {
    "commands": [
      {
        "command": "uvision-fast.open",
        "title": "uVision Fast: Open Keil µVision 5 IDE",
        "icon": "$(circuit-board)"
      },
      {
        "command": "uvision-fast.openFile",
        "title": "uVision Fast: Open Current File/Project in µVision",
        "icon": "$(circuit-board)"
      },
      {
        "command": "uvision-fast.build",
        "title": "uVision Fast: Build"
      },
      {
        "command": "uvision-fast.debug",
        "title": "uVision Fast: Start Debug"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "uvision-fast.openFile",
          "when": "resourceExtname =~ /^\\.(s|S|asm|c|h|uvprojx)$/i",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "uvision-fast.openFile",
          "when": "resourceExtname =~ /^\\.(s|S|asm|c|h|uvprojx)$/i",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "uVision Fast",
      "properties": {
        "uvisionFast.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to uvcli.exe (leave empty to auto-discover)"
        },
        "uvisionFast.keilRoot": {
          "type": "string",
          "default": "",
          "description": "Override Keil_v5 root path"
        },
        "uvisionFast.openocdPath": {
          "type": "string",
          "default": "",
          "description": "Override openocd.exe path"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
